# ------------------------------------------------------------------
# Rook & Roll — environment variables
# Copy to `.env` (or `.env.local`) and fill in. Nothing here is secret
# by default; generate real secrets for production.
# ------------------------------------------------------------------

# --- Auth (NextAuth / Auth.js) ---
# Generate: `openssl rand -base64 32`  (or `npx auth secret`)
AUTH_SECRET="replace-with-a-32-byte-random-string"
# Public base URL of the Next.js app. Locally this is http://localhost:3000
AUTH_URL="http://localhost:3000"

# Optional Google OAuth (leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Database (Postgres via Neon or Supabase) ---
# Neon example:     postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/rookandroll?sslmode=require
# Supabase example: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Leave unset to run without accounts (local pass-and-play + bots still work).
DATABASE_URL=""

# --- Realtime multiplayer server ---
# URL of the separately-deployed Socket.io server (Railway/Render/Fly).
# Used by the browser to connect, so it must be public and start with NEXT_PUBLIC_.
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# The realtime server (server/) reads these:
#   PORT=4000
#   CLIENT_ORIGIN=http://localhost:3000   # the Next.js app origin, for CORS
#   DATABASE_URL=...                       # same Postgres, to persist finished games

# --- Admin panel (Phase 7+) ---
# bcrypt hash of the admin password. Generate with:
#   node scripts/hash-admin-password.mjs 'your-strong-password'
# NOTE: in THIS local file, escape every $ as \$ (dotenv-expand). On Vercel/
# Render dashboards, paste the RAW hash. Leave unset to disable admin entirely.
ADMIN_PASSWORD_HASH=""
# Secret for signing the short-lived admin session JWT (separate from AUTH_SECRET).
# openssl rand -base64 32
ADMIN_JWT_SECRET=""
