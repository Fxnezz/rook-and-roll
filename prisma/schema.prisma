// Sam's Arcade — data model.
// Postgres (Supabase or Neon) via Prisma. See README for setup.

generator client {
  provider = "prisma-client-js"
}

// The realtime server is installed as a separate package on Render. Generate
// a dedicated client beside it so runtime resolution never depends on npm
// hoisting or on the root application's node_modules layout.
generator realtimeClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Admin / moderation (Phase 7+)
// ---------------------------------------------------------------------------

// Key/value platform config: maintenance mode, feature flags, active broadcast.
model AppConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt
}

// Append-only record of every admin action and login attempt. Never deleted.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actor      String   @default("admin") // admin identifier (single-admin for now)
  action     String // e.g. admin_login_success, user_ban, game_force_result
  targetType String? // "user" | "game" | "chat" | ...
  targetId   String?
  ip         String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([ip, action, createdAt])
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js Prisma adapter models + credentials password hash)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  // Current ratings per time-control category (Glicko-ish Elo).
  ratingBullet    Int @default(1200)
  ratingBlitz     Int @default(1200)
  ratingRapid     Int @default(1200)
  ratingClassical Int @default(1200)
  puzzleRating    Int @default(1000)
  puzzleStreak    Int @default(0)

  // Moderation (admin, Phase 8)
  status           UserStatus @default(ACTIVE)
  moderationReason String?
  bannedUntil      DateTime? // null while BANNED = permanent
  mutedUntil       DateTime? // can play but not chat until this passes
  /** Legacy compatibility flag. Shield authority is derived from the exact owner email in application code. */
  isModerator      Boolean    @default(false)
  /** Legacy compatibility flag. It cannot grant /admin access; see src/lib/admin/owner.ts. */
  isAdmin          Boolean    @default(false)

  // Notification & privacy preferences (src/app/account/page.tsx). Server-synced
  // (not the client-only localStorage settings in useSettings.tsx) because both
  // are enforced by server-side code — the friend-request API and the realtime
  // presence server — not just client rendering.
  /** Whether a Notification row is written when someone sends/accepts a friend request. */
  notifyFriendRequests Boolean @default(true)
  /** Whether a Notification row is written when an accepted friend comes online. */
  notifyFriendOnline   Boolean @default(true)
  /** When false, this user is excluded from other users' online/presence results (friends list, friend-online notifications). */
  showOnlineStatus     Boolean @default(true)
  /** Whether a Notification row is written when the user earns a new achievement. */
  notifyAchievements   Boolean @default(true)
  /** Whether a Notification row is written when a rated game the user played finishes. */
  notifyGameResults    Boolean @default(true)
  /** Bumped by "sign out of all other devices" — embedded in the JWT at login and checked on every session read (src/lib/auth/auth.ts); a mismatch invalidates that token. */
  sessionVersion       Int     @default(0)
  /** Free-text profile bio shown on the public profile page. */
  bio                  String? @db.VarChar(280)
  /** Achievement id (see UserAchievement) the user has chosen to feature prominently on their profile. */
  pinnedAchievementId  String?

  accounts        Account[]
  sessions        Session[]
  gamesAsWhite    Game[]          @relation("WhiteGames")
  gamesAsBlack    Game[]          @relation("BlackGames")
  ratingHistory   RatingHistory[]
  puzzleAttempts  PuzzleAttempt[]
  friendsInit     Friendship[]    @relation("Requester")
  friendsRecv     Friendship[]    @relation("Addressee")
  friendsBlocked  Friendship[]    @relation("BlockedBy")
  loginEvents     LoginEvent[]
  notifications   Notification[]
  gameRatings     GameRating[]
  highScores      HighScore[]
  wordStats       WordGameStats?
  reportsFiled    Report[]        @relation("ReportsFiled")
  reportsReceived Report[]        @relation("ReportsReceived")
  warnings        Warning[]
  achievements    UserAchievement[]
}

// A player-filed report against another player, reviewed in the admin
// Reports queue. reporterId is nullable so a reporter's account being later
// deleted doesn't cascade-delete the report itself.
model Report {
  id         String       @id @default(cuid())
  reporterId String?
  reportedId String
  reason     String
  detail     String?      @db.Text
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter User? @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  reported User  @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reportedId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// A formal warning short of a mute/ban — logged and sent to the user's inbox.
model Warning {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// IP addresses blocked from logging in or registering (ban-evasion tool).
model BannedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Games Hub (Phases 11-15) — generic per-game rating + arcade high scores,
// reused across Connect Four, Checkers, Snake, Tetris, 2048, racing, platformer
// rather than adding bespoke columns/tables per game.
// ---------------------------------------------------------------------------

model GameRating {
  id        String   @id @default(cuid())
  userId    String
  game      String // "connect4" | "checkers"
  rating    Int      @default(1200)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
}

model HighScore {
  id        String   @id @default(cuid())
  userId    String
  game      String // "snake" | "tetris" | "2048" | "racing" | "platformer"
  /**
   * score for arcade games; best lap/level time in ms for racing/platformer
   */
  score     Int
  /**
   * optional sub-key, e.g. a platformer level id — null for whole-game scores
   */
  level     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, game])
  @@index([game, level, score])
}

model WordGameStats {
  userId         String   @id
  played         Int      @default(0)
  wins           Int      @default(0)
  currentStreak  Int      @default(0)
  maxStreak      Int      @default(0)
  guessDist      Int[]    @default([0, 0, 0, 0, 0, 0])
  lastPlayedDate String? // YYYY-MM-DD, guards against replaying the same daily
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE
  MUTED
  SUSPENDED
  BANNED
}

// Login/IP history for admin review.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  method    String   @default("credentials") // credentials | google | impersonation
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A user's in-app inbox entry — admin direct messages plus system-generated
// events (friend requests, achievements, game results, ...).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  /** What this notification is about — drives grouping/collapsing in the bell UI. */
  type      NotificationType @default(SYSTEM)
  /** Optional deep-link target clicking the row navigates to, e.g. "/friends", "/u/username". */
  href      String?
  fromAdmin Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_ONLINE
  ACHIEVEMENT
  GAME_RESULT
  SYSTEM
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Games
// ---------------------------------------------------------------------------

enum GameResult {
  WHITE_WINS
  BLACK_WINS
  DRAW
  ABORTED
}

enum OpponentType {
  HUMAN
  BOT
}

model Game {
  id           String       @id @default(cuid())
  whiteId      String?
  blackId      String?
  whiteName    String
  blackName    String
  opponentType OpponentType @default(HUMAN)
  botTier      String?
  rated        Boolean      @default(false)
  category     String // bullet | blitz | rapid | classical | untimed
  timeControl  String // e.g. "5+0"
  result       GameResult
  termination  String // checkmate, resignation, timeout, draw reason, ...
  pgn          String       @db.Text
  finalFen     String
  ply          Int          @default(0)
  /** Player-side bookmark on their own finished game — toggled from the game history list. */
  favorited    Boolean      @default(false)
  /** Deepest matching book-opening name (src/lib/openings), computed at save time. */
  opening      String?
  /** ECO code of that opening, e.g. "C50". */
  eco          String?
  /** Per-ply think time in ms, index 0 = move 1 (client-tracked; bot/local games only). */
  moveTimes    Json?
  /** Engine-review accuracy 0-100, computed client-side and persisted on request (batch or per-game "Analyze"). */
  accuracyW    Int?
  accuracyB    Int?
  /** True for games created via pasted-PGN import rather than actually played on the site. */
  imported     Boolean      @default(false)

  whiteRatingBefore Int?
  blackRatingBefore Int?
  whiteRatingAfter  Int?
  blackRatingAfter  Int?

  createdAt DateTime @default(now())

  white User?  @relation("WhiteGames", fields: [whiteId], references: [id], onDelete: SetNull)
  black User?  @relation("BlackGames", fields: [blackId], references: [id], onDelete: SetNull)
  moves Move[]

  @@index([whiteId])
  @@index([blackId])
  @@index([createdAt])
}

model Move {
  id     String @id @default(cuid())
  gameId String
  ply    Int
  san    String
  uci    String
  fen    String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model RatingHistory {
  id        String   @id @default(cuid())
  userId    String
  category  String // bullet | blitz | rapid | classical | puzzle
  rating    Int
  delta     Int
  gameId    String?
  kind      String   @default("game") // "game" | "admin" (adjustment marker)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
  DECLINED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  /** Who initiated a BLOCKED status — not necessarily requesterId, since either side of an existing friendship can block. */
  blockedById String?
  /** Set when status becomes DECLINED — used as the start of the re-request cooldown window. */
  declinedAt  DateTime?
  createdAt   DateTime         @default(now())

  requester User  @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User  @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  blockedBy User? @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

// ---------------------------------------------------------------------------
// Achievements
// ---------------------------------------------------------------------------

// Catalog of earnable badges. Rows are seeded by the migration itself (see
// the migration SQL) rather than a separate per-environment seed script —
// the canonical list lives in src/lib/achievements/catalog.ts and is mirrored
// into the migration's INSERT statements.
model Achievement {
  id          String @id
  name        String
  description String
  category    String // milestone | streak | special
  icon        String // emoji

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Puzzles
// ---------------------------------------------------------------------------

model Puzzle {
  id         String   @id @default(cuid())
  fen        String
  // Solution as a line of UCI moves; the side to move plays index 0, 2, 4…
  solution   String[]
  themes     String[]
  rating     Int      @default(1200)
  popularity Int      @default(0)
  source     String?
  createdAt  DateTime @default(now())

  attempts PuzzleAttempt[]

  @@index([rating])
}

model PuzzleAttempt {
  id           String   @id @default(cuid())
  userId       String
  puzzleId     String
  solved       Boolean
  ratingBefore Int
  ratingAfter  Int
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([userId])
}
